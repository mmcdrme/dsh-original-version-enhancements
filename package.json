{
  "name": "@local/dsh-original-version-enhancements",
  "version": "1.35.1",
  "private": true,
  "description": "原版功能增强：四档工作详情切换、已归档会话管理（搜索/恢复/确认删除）、自动化任务增强、发送历史回溯，以及由自带 exe（WebView2）承载、可最小化与调透明度的独立会话窗口。",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/*.mjs",
    "native/OveWindow.exe",
    "native/Microsoft.Web.WebView2.Core.dll",
    "native/Microsoft.Web.WebView2.WinForms.dll",
    "native/WebView2Loader.dll",
    "native/OveWindow.cs",
    "native/app.ico",
    "native/app.manifest",
    "native/make-icon.ps1",
    "css/*.css",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
